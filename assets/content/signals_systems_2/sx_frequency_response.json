              },
              {
                "label": "$\\angle H$",
                "value": "deg(ph)",
                "unit": "°"
              }
            ]
          }
        },
        {
          "id": "i3",
          "type": "info",
          "title": "Ideal filters",
          "body": "An **ideal** filter has gain 1 in its pass band and 0 in its stop band, with a vertical edge at the cutoff $\\omega_c$. There are four basic types: low-pass, high-pass, band-pass and band-stop. The graph shows an ideal low-pass.",
          "plot": {
            "x": {
              "min": 0,
              "max": 3,
              "label": "ω/ω_c"
            },
            "y": {
