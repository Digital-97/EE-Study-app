                  5,
                  1
                ],
                "label": "v_{out}"
              }
            ]
          }
        },
        {
          "id": "q3",
          "type": "multipleChoice",
          "prompt": "What is the phase of the RC low-pass $H(j\\omega) = \\frac{1}{1 + j\\omega RC}$ at $\\omega = 1/RC$?",
          "options": [
            "−45°",
            "−90°",
            "0°",
            "+45°"
          ],
          "answer": 0,
          "explanation": "At $\\omega = 1/RC$ the denominator is $1 + j$, whose angle is +45°. Dividing by it gives $\\angle H = -45°$ (and $|H| = 1/\\sqrt{2}$). The phase goes from 0° at DC to −90° at very high frequencies."
        },
        {
          "id": "i5",
          "type": "info",
          "title": "Try it: a sinusoid through the RC low-pass",
          "body": "Grey: the input $\\cos\\omega t$; green: the output in steady state. Drag the input frequency. The output keeps the **same frequency** but is scaled by $|H|$ and delayed by the phase $\\angle H = -\\arctan(\\omega/\\omega_c)$: at $\\omega_c$ it is 0.707 times as large and lags by 45°; far above $\\omega_c$ it is small and lags by almost 90°.",
          "plot": {
            "x": {
              "min": 0,
              "max": 2,
              "label": "t / T",
              "ticks": [
                0,
                0.5,
                1,
                1.5,
                2
              ]
            },
            "y": {
              "min": -1.3,
              "max": 1.3,
              "label": "",
              "ticks": [
                -1,
                0,
                1
              ]
            },
            "sliders": [
              {
                "name": "k",
                "label": "$\\omega/\\omega_c$",
                "min": 0.1,
                "max": 10,
                "log": true,
                "value": 1
              }
            ],
            "let": {
              "M": "1/sqrt(1+k^2)",
              "ph": "-atan(k)"
            },
            "curves": [
              {
                "f": "cos(2*pi*x)",
                "color": "grey"
              },
              {
                "f": "M*cos(2*pi*x + ph)"
              }
