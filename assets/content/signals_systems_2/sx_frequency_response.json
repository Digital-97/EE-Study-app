                "type": "wire",
                "points": [
                  [
                    3,
                    0
                  ],
                  [
                    5,
                    0
                  ]
                ]
              },
              {
                "type": "wire",
                "points": [
                  [
                    0,
                    2
                  ],
                  [
                    5,
                    2
                  ]
                ]
