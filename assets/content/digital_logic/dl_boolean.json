  "lessons": [
    {
      "id": "dl-boolean-1",
      "title": "Laws of Boolean algebra",
      "kind": "learn",
      "steps": [
        {
          "id": "i1",
          "type": "info",
          "title": "Rules for 0 and 1",
          "body": "In Boolean algebra, AND acts like multiplication and OR like a strange addition where $1 + 1 = 1$. A few rules follow directly from the truth tables:",
          "formula": "A + 1 = 1,\\quad A\\cdot 0 = 0,\\quad A + A = A,\\quad A\\overline{A} = 0,\\quad A + \\overline{A} = 1"
        },
        {
          "id": "q1",
          "type": "multipleChoice",
          "prompt": "Simplify $A + 1$.",
          "options": [
            "$1$",
            "$A$",
            "$0$",
            "$\\overline{A}$"
          ],
          "answer": 0,
          "explanation": "An OR gate with one input fixed at 1 always outputs 1, whatever $A$ is: $A + 1 = 1$. (Compare $A\\cdot 1 = A$.)"
        },
        {
          "id": "q2",
          "type": "matchPairs",
          "prompt": "Match each expression to its simplified form.",
          "pairs": [
            [
              "$A\\overline{A}$",
              "$0$"
            ],
            [
              "$A + \\overline{A}$",
              "$1$"
            ],
            [
              "$A + AB$",
              "$A$"
            ],
            [
              "$A + \\overline{A}B$",
              "$A + B$"
            ]
          ],
          "explanation": "A variable and its complement are never both 1, so $A\\overline{A} = 0$, but one of them always is, so $A + \\overline{A} = 1$. Absorption: $A + AB = A(1 + B) = A$. And $A + \\overline{A}B = (A + \\overline{A})(A + B) = A + B$."
        },
        {
          "id": "i2",
          "type": "info",
          "title": "De Morgan's laws",
          "body": "To complement an AND, complement each variable and change it to an OR, and vice versa. Breaking a long bar changes the operation under it.",
          "formula": "\\overline{AB} = \\overline{A} + \\overline{B}, \\qquad \\overline{A+B} = \\overline{A}\\,\\overline{B}"
        },
        {
          "id": "q3",
          "type": "multipleChoice",
          "prompt": "Which expression equals $\\overline{A + B + C}$?",
          "options": [
            "$\\overline{A}\\,\\overline{B}\\,\\overline{C}$",
            "$\\overline{A} + \\overline{B} + \\overline{C}$",
            "$ABC$",
            "$\\overline{ABC}$"
          ],
          "answer": 0,
          "explanation": "De Morgan extends to any number of variables: break the bar, complement each variable, change OR into AND: $\\overline{A+B+C} = \\overline{A}\\,\\overline{B}\\,\\overline{C}$. Both are 1 only when all inputs are 0."
        },
        {
          "id": "q4",
          "type": "trueFalse",
          "prompt": "In Boolean algebra, $A + BC = (A+B)(A+C)$.",
          "answer": true,
          "explanation": "Expand the right side: $(A+B)(A+C) = AA + AC + AB + BC = A + AC + AB + BC = A(1 + C + B) + BC = A + BC$. OR distributes over AND, which has no equivalent in ordinary algebra."
        },
        {
          "id": "i3",
          "type": "info",
          "title": "Simplifying",
          "body": "Look for terms that differ in only one variable: they combine, because $X + \\overline{X} = 1$.\nExample: $A\\overline{B}C + ABC = AC(\\overline{B} + B) = AC$."
        },
        {
          "id": "q5",
          "type": "multipleChoice",
          "prompt": "Simplify $AB + A\\overline{B}$.",
          "options": [
            "$A$",
            "$B$",
            "$1$",
            "$AB$"
          ],
          "answer": 0,
          "explanation": "Factor out $A$: $AB + A\\overline{B} = A(B + \\overline{B}) = A\\cdot 1 = A$. The output does not depend on $B$ at all."
        },
        {
          "id": "q6",
          "type": "trueFalse",
          "prompt": "$\\overline{AB} = \\overline{A}\\,\\overline{B}$",
          "answer": false,
          "explanation": "De Morgan gives $\\overline{AB} = \\overline{A} + \\overline{B}$. Counter-example: $A = 1, B = 0$: $\\overline{AB} = \\overline{0} = 1$, but $\\overline{A}\\,\\overline{B} = 0\\cdot 1 = 0$."
        }
      ]
    },
    {
      "id": "dl-boolean-2",
      "title": "Simplify and transform",
      "kind": "practice",
      "steps": [
        {
          "id": "q1",
          "type": "multipleChoice",
          "prompt": "Simplify $A + \\overline{A}B$.",
          "options": [
            "$A + B$",
            "$A$",
            "$B$",
            "$AB$"
          ],
          "answer": 0,
          "explanation": "Use $X + YZ = (X+Y)(X+Z)$: $A + \\overline{A}B = (A + \\overline{A})(A + B) = 1\\cdot(A+B) = A + B$. Check: if $A = 1$ both sides are 1; if $A = 0$ both sides equal $B$."
        },
        {
          "id": "q2",
          "type": "multipleChoice",
          "prompt": "Apply De Morgan's laws to $\\overline{A\\overline{B} + C}$.",
          "options": [
            "$(\\overline{A} + B)\\,\\overline{C}$",
            "$(\\overline{A} + \\overline{B})\\,\\overline{C}$",
            "$\\overline{A}B + \\overline{C}$",
            "$\\overline{A} + B + \\overline{C}$"
          ],
          "answer": 0,
          "explanation": "Outer bar first: $\\overline{X + C} = \\overline{X}\\,\\overline{C}$ with $X = A\\overline{B}$. Then $\\overline{A\\overline{B}} = \\overline{A} + \\overline{\\overline{B}} = \\overline{A} + B$. Result: $(\\overline{A} + B)\\overline{C}$. The parentheses matter: the OR must be evaluated before the AND."
        },
        {
          "id": "q3",
          "type": "multipleChoice",
          "prompt": "Simplify $(A + B)(A + \\overline{B})$.",
          "options": [
