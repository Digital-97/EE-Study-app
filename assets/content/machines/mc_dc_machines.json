     "unit": "V",
     "explanation": "$\\omega_m$ = {{n||4}} × 2π/60 = {{2*pi*n/60|rad/s}}. $E_A = K\\phi\\,\\omega_m$ = {{Kp}} × {{2*pi*n/60}} = {{Kp*2*pi*n/60|V}}.",
     "params": {
