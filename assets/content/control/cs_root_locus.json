    {
      "id": "cs-root-locus-2",
      "title": "Sketching rules",
      "kind": "practice",
      "steps": [
        {
          "id": "p1",
          "type": "numeric",
          "params": {
            "a": [
              1,
              2
            ],
            "b": [
              3,
              4
            ],
            "c": [
              5,
              6,
              8
            ],
            "z": [
              1,
              2,
              3
            ]
          },
          "require": "abs(z-a)*abs(z-b)",
          "prompt": "Find the centroid of the asymptotes for $G(s) = \\frac{K(s+{{z}})}{s(s+{{a}})(s+{{b}})(s+{{c}})}$.",
          "answer": "(-a-b-c+z)/3",
          "unit": "",
          "explanation": "$n = 4$, $m = 1$, so $n - m = 3$. $\\sum p_i = 0 - {{a}} - {{b}} - {{c}}$ = {{-a-b-c}}, $\\sum z_j = -{{z}}$. $\\sigma_a = \\frac{{{-a-b-c}} - ({{-z}})}{3}$ = {{(-a-b-c+z)/3}}. (Forgetting to subtract the zero would give {{(-a-b-c)/3}}.)"
        },
        {
          "id": "p2",
          "type": "numeric",
          "params": {
            "a": [
              1,
              2,
              3
            ],
            "d": [
              1,
              2,
              3
            ]
          },
          "derived": {
            "b": "a+d"
          },
          "prompt": "Find the breakaway point (on the real axis between $-{{a}}$ and 0) of the root locus of $G(s) = \\frac{K}{s(s+{{a}})(s+{{b}})}$.",
          "answer": "(-(a+b)+sqrt((a+b)^2-3*a*b))/3",
          "unit": "",
          "explanation": "$K = -s(s+{{a}})(s+{{b}}) = -(s^3 + {{a+b}}s^2 + {{a*b}}s)$. $dK/ds = 0$: $3s^2 + {{2*(a+b)}}s + {{a*b}} = 0$, so $s = \\frac{-{{2*(a+b)}} \\pm \\sqrt{{{(2*(a+b))^2}} - {{12*a*b}}}}{6}$. The root between $-{{a}}$ and 0 is $s$ = {{(-(a+b)+sqrt((a+b)^2-3*a*b))/3}}; the other one ({{(-(a+b)-sqrt((a+b)^2-3*a*b))/3}}) is not on the locus."
        },
        {
          "id": "p3",
          "type": "numeric",
          "params": {
            "a": [
              2,
              4,
              6,
              8
            ],
            "w": [
              1,
              2,
              3,
              4
            ]
          },
          "derived": {
            "Y": "1.25*max(w,a/2)+1"
          },
          "prompt": "The root locus of $G(s) = \\frac{K}{s(s+{{a}})}$ is shown. A closed-loop pole is at the marked point.",
          "plot": {
            "x": {
              "min": "-1.5*a",
              "max": "0.5*a",
              "label": "σ"
            },
            "y": {
              "min": "-(Y)",
              "max": "Y",
              "label": "jω"
            },
            "curves": [
              {
                "f": "0",
                "from": "-a",
                "to": 0
              },
              {
                "f": "(x-(-a/2))*1000000",
                "from": "-a/2",
                "to": "(-a/2)+(Y)/1000000"
              },
              {
                "f": "-(x-(-a/2))*1000000",
                "from": "-a/2",
                "to": "(-a/2)+(Y)/1000000"
              }
            ],
            "points": [
              {
                "x": 0,
                "y": 0,
                "marker": "x",
                "color": "red",
                "guides": false
              },
              {
                "x": "-a",
                "y": 0,
                "marker": "x",
                "color": "red",
                "guides": false
              },
              {
                "x": "-a/2",
                "y": "w",
                "color": "orange",
                "marker": "dot"
              }
            ]
          },
          "ask": [
            {
              "prompt": "Find the gain $K$ that puts it there.",
              "answer": "(a/2)^2+w^2",
              "unit": "",
              "explanation": "The point is $s_0 = -{{a/2}} + j{{w}}$. Magnitude condition: $K = |s_0|\\cdot|s_0 + {{a}}|$. Both distances equal $\\sqrt{{{a/2}}^2 + {{w}}^2}$, so $K = {{a/2}}^2 + {{w}}^2$ = {{(a/2)^2+w^2}}."
            },
            {
              "prompt": "Find the damping ratio $\\zeta$ of the closed-loop poles.",
              "answer": "(a/2)/sqrt((a/2)^2+w^2)",
              "unit": "",
              "explanation": "$s_0 = -{{a/2}} + j{{w}}$: $\\omega_n = |s_0| = \\sqrt{{{a/2}}^2 + {{w}}^2}$ = {{sqrt((a/2)^2+w^2)}}, $\\zeta = \\sigma/\\omega_n$ = {{(a/2)/sqrt((a/2)^2+w^2)}}."
            }
          ]
        },
        {
          "id": "p4",
          "type": "numeric",
