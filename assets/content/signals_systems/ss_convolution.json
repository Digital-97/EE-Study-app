        {
          "id": "q3",
          "type": "numeric",
          "prompt": "The graph shows $x(t)$ (solid) and $h(t)$ (dashed), $t$ in s. Find $y(t) = x * h$ at $t = {{t0}}$ s.",
          "answer": "A*B*max(0, min(t0,T1) - max(0, t0-T2))",
