{
 "id": "fr-resonance",
 "title": "Resonance",
 "description": "Series and parallel RLC resonance, quality factor, bandwidth and second-order filters.",
 "reference": "Hambley §6.6–6.8; H&H §1.22; Frenzel §2-2",
 "study": [
  {
   "title": "Series resonance",
   "body": "The source sees $Z_s = R + j2\\pi fL - j\\frac{1}{2\\pi fC}$. At the resonant frequency $f_0$ the inductive and capacitive reactances are equal and cancel, so $Z_s = R$: purely resistive and **minimum**. The current is then maximum, $I = V_s/R$. Below $f_0$ the circuit is capacitive, above it inductive.",
   "formula": "f_0 = \\frac{1}{2\\pi\\sqrt{LC}}",
